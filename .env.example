# Copia questo file in .env e inserisci le chiavi: cp .env.example .env

# --- Chiavi API (restano solo sul server, mai nel browser) ---
ASSEMBLYAI_API_KEY=
DEEPL_API_KEY=

# --- DeepL ---
# Piani gratuiti: https://api-free.deepl.com   -   Piani a pagamento: https://api.deepl.com
DEEPL_ENDPOINT=https://api-free.deepl.com
# latency_optimized = più veloce | prefer_quality_optimized = migliore qualità | vuoto = predefinito DeepL
DEEPL_MODEL_TYPE=latency_optimized
# Invia la frase precedente come contesto: migliora la traduzione e non consuma caratteri
DEEPL_USE_CONTEXT=true

# --- Server ---
PORT=8787
HOST=0.0.0.0
# La pagina di controllo risponde solo dal Mac stesso. Metti true solo su una rete fidata.
CONTROL_ALLOW_LAN=false

# --- Lingua ---
# Modalità all'avvio: AUTO, IT o EN.
# Dopo un riavvio vale l'ultima modalità usata, a meno che tu non cambi questo valore.
DEFAULT_LANGUAGE_MODE=AUTO
# Lingua usata in AUTO finché non ne viene rilevata una valida: it oppure en
FALLBACK_LANGUAGE=it

# --- Pulizia del testo ---
CLEAN_FILLERS=true
CLEAN_PROFANITY=true

# --- AssemblyAI ---
ASSEMBLYAI_WS_URL=wss://streaming.assemblyai.com/v3/ws
ASSEMBLYAI_SPEECH_MODEL=universal-3-6-pro
# Listino verificato a novembre 2026, usato solo per la stima dei crediti nella pagina di controllo
ASSEMBLYAI_PRICE_PER_HOUR=0.45
# Silenzio che chiude un turno, in millisecondi. Vuoto = predefinito AssemblyAI.
MIN_TURN_SILENCE=
MAX_TURN_SILENCE=
# Chiude un turno che dura più di questi secondi, così la traduzione non resta indietro
# con chi parla senza pause. 0 = disattivato.
MAX_TURN_SECONDS=15
# Anticipo con cui aprire la nuova sessione prima del limite di 3 ore
SESSION_ROLLOVER_BEFORE_SECONDS=120
# Solo per i test: forza il cambio di sessione dopo N secondi. Vuoto in produzione.
SESSION_MAX_SECONDS=
